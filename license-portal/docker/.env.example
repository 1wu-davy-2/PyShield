# PyShield license portal - Docker deployment settings
#
# Copy this file to `.env`, keep it root-readable only (chmod 600), and never
# commit the real file. It is read by Docker Compose for ${...} interpolation
# and passed to the portal as PYSHELD_PORTAL_* environment variables.

# ---------------------------------------------------------------------------
# Image, container and host port
# ---------------------------------------------------------------------------
PYSHELD_PORTAL_IMAGE=pyshield-license-portal:latest
PYSHELD_PORTAL_CONTAINER_NAME=pyshield-license-portal
# Optional npm registry for the web build, for example:
# PYSHELD_PORTAL_NPM_REGISTRY=https://registry.npmmirror.com
PYSHELD_PORTAL_NPM_REGISTRY=
# The service always listens on 0.0.0.0:8091 INSIDE the container (compose.yaml).
# These two values only control the HOST-side publish:
#   Nginx in front: BIND_ADDR=127.0.0.1, HTTP_PORT = port Nginx proxies to
#   Direct access:  BIND_ADDR=0.0.0.0, also set TRUST_PROXY=false
PYSHELD_PORTAL_BIND_ADDR=127.0.0.1
PYSHELD_PORTAL_HTTP_PORT=8091

# Host directory containing portal.sqlite3, portal.secret, signing.key and
# signing.pass. Must be an absolute path. Docker creates it as root on first
# start; the entrypoint then chowns it to the unprivileged container user.
# Never point this at the image source directory or a root-level system
# directory such as /etc, /usr or /var.
PYSHELD_PORTAL_HOST_DATA_DIR=/etc/pyshield-portal

# ---------------------------------------------------------------------------
# Public site settings
# ---------------------------------------------------------------------------
# Must exactly match the browser origin (scheme + host + optional port).
# Production: https://license.example.com
PYSHELD_PORTAL_SITE_URL=https://license.example.com
PYSHELD_PORTAL_SITE_NAME="PyShield 授权中心"
PYSHELD_PORTAL_CONTACT_WECHAT=
PYSHELD_PORTAL_SUPPORT_EMAIL=

PYSHELD_PORTAL_TRIAL_DAYS=14
PYSHELD_PORTAL_TRIAL_BUILDS=3
PYSHELD_PORTAL_TRIAL_GRACE_DAYS=0
PYSHELD_PORTAL_RATE_LIMIT_PER_HOUR=12
PYSHELD_PORTAL_KEY_REDEMPTION_DAYS=30
PYSHELD_PORTAL_SESSION_HOURS=12
PYSHELD_PORTAL_MAX_BODY=65536

# ---------------------------------------------------------------------------
# E-mail verification (needed by the public trial flow in production)
# ---------------------------------------------------------------------------
# Either fill in SMTP below, or set EMAIL_VERIFICATION=false for a local smoke
# test. Leaving it true with empty SMTP makes trial applications fail.
PYSHELD_PORTAL_EMAIL_VERIFICATION=true
PYSHELD_PORTAL_SMTP_HOST=
PYSHELD_PORTAL_SMTP_PORT=587
PYSHELD_PORTAL_SMTP_USER=
PYSHELD_PORTAL_SMTP_PASSWORD=
PYSHELD_PORTAL_SMTP_FROM=
PYSHELD_PORTAL_SMTP_FROM_NAME="PyShield 授权中心"
PYSHELD_PORTAL_SMTP_REPLY_TO=
# starttls | ssl | none
PYSHELD_PORTAL_SMTP_TLS=starttls

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional)
# ---------------------------------------------------------------------------
PYSHELD_PORTAL_TURNSTILE_SITE_KEY=
PYSHELD_PORTAL_TURNSTILE_SECRET=

# ---------------------------------------------------------------------------
# Proxy and admin console security
# ---------------------------------------------------------------------------
# true is appropriate when the published port is bound to 127.0.0.1 and Nginx
# on the same host forwards X-Forwarded-For. If you expose 8091 directly, set
# this to false so clients cannot spoof their source IP.
PYSHELD_PORTAL_TRUST_PROXY=true
# Leave empty to derive from SITE_URL; set explicitly only if you terminate TLS
# differently from what SITE_URL describes. Public plain-HTTP sites (for example
# http://SERVER_IP with no TLS) MUST set false, otherwise the browser will not
# send the admin session cookie back.
PYSHELD_PORTAL_SECURE_COOKIES=
# Comma-separated IPs/CIDRs allowed to use /api/admin/*. Empty means all IPs.
PYSHELD_PORTAL_ADMIN_ALLOW_IPS=

# ---------------------------------------------------------------------------
# First-run administrator
# ---------------------------------------------------------------------------
# Used only when /etc/pyshield-portal/portal.sqlite3 does not exist. The
# default is intentionally the requested bootstrap value; replace it with a
# strong 10+ character password before exposing the service, or change it
# immediately after the first login. Existing databases are never reset.
PYSHELD_PORTAL_ADMIN_USER=admin
PYSHELD_PORTAL_ADMIN_PASSWORD=admin123@

# ---------------------------------------------------------------------------
# Signing key
# ---------------------------------------------------------------------------
# Leave empty to use the generated signing.pass inside the data directory.
# For production, provide a strong passphrase here and back it up separately
# from signing.key. Losing it makes existing signing.key unusable.
PYSHELD_PORTAL_SIGNING_PASSPHRASE=
