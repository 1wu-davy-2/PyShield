# Build context is the PyShield repository root. Keep the image free of
# local build products, test data and any signing/credential material.
.git
.gitignore
.github
.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache

build
dist
dist-*
*.spec
HA7HqyYHFsn4CepB-grok-workspace
review
.tmp-portal-demo
.pyshield-demo
.pyshield-native
license-data

node_modules
license-portal/web/node_modules
license-portal/web/dist
license-portal/web/.vite
license-portal/config.json
license-portal/docker/.env

# Never put private keys, generated bindings or local license files in an image.
root.key
root.pub
pyshield/_tool_key.py
pyshield/_site.py
*.lic
*.shield-secret.json
**/portal.sqlite3*
**/portal.secret
**/signing.key
**/signing.pass
